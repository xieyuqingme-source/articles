# Public examples only; this file is not loaded or deployed automatically.
# Set approved values in the separate Vercel backend's Production environment.
SITE_NAME=谢雨聊 · 谢雨卿的文章
SITE_URL=https://xieyuqing.me/articles/
SERVER_URL=https://yuliao-comments.vercel.app
# Hostnames only. The example entry explicitly reads this list and adds SERVER_URL's host.
SECURE_DOMAINS=xieyuqing.me,yuliao-comments.vercel.app
LOGIN=disable
# Plain false: no literal quotes or surrounding spaces. Guest comments publish directly.
COMMENT_AUDIT=false
# Confirmed display choice: keep IP region, hide browser/OS labels.
# The user-deployed display behavior is verified; this example file is not loaded automatically.
DISABLE_REGION=false
DISABLE_USERAGENT=true
IPQPS=60
PG_SSL=true

# Privacy proposals, not confirmed/applied on the live backend. Do not bulk-copy.
# Uncomment only the choices confirmed by the site owner, then redeploy and verify.
# DISABLE_USERAGENT hides parsed labels; it does not delete stored/raw UA.
# AKISMET_KEY=false
# DISABLE_AUTHOR_NOTIFY=true
# AVATAR_PROXY=false
# If choosing the fixed local avatar, merge avatarUrl() from index.example.cjs.
# The hook then becomes the single avatar setting; do not also set GRAVATAR_STR.
# Existing database credentials stay in the hosting integration; do not copy them here.
# Do not add SMTP_*, AUTHOR_EMAIL, WEBHOOK, OAuth or captcha service credentials here.
